{
  "project": "Marketing Buddy",
  "repository": "morningzy123-cloud/first-website",
  "productionBranch": "main",
  "deploymentProvider": "vercel_git_integration",
  "publicUrl": "https://first-website-five-chi.vercel.app/",
  "timezone": "Asia/Shanghai",
  "schedule": {
    "enabled": false,
    "recommended": "weekly",
    "note": "由用户在选定的 AI/自动化平台中设置具体星期和时间。"
  },
  "monitoringWindowDays": 30,
  "markets": [
    { "code": "MX", "name": "Mexico", "languages": ["es", "en"] },
    { "code": "KZ", "name": "Kazakhstan", "languages": ["ru", "kk", "en"] },
    { "code": "SA", "name": "Saudi Arabia", "languages": ["ar", "en"] },
    { "code": "AE", "name": "United Arab Emirates", "languages": ["ar", "en"] }
  ],
  "paths": {
    "canonicalData": "data/autointel-v1.6.global.json",
    "browserBundle": "data/autointel-v1.6.bundle.js",
    "weeklyReports": "reports/weekly",
    "bundleScript": "scripts/bundle-data.mjs",
    "validatorScript": "scripts/validate-data.mjs",
    "siteTestScript": "scripts/test-site.mjs"
  },
  "automaticPublication": [
    "official_price_change",
    "official_promotion_start_change_expiry",
    "official_finance_offer",
    "official_warranty_aftersales",
    "comparable_sales_update",
    "dated_official_marketing_activity",
    "source_metadata_correction"
  ],
  "humanReviewRequired": [
    "competitor_add_remove_adopt_or_retier",
    "vehicle_specific_tariff_or_origin_application",
    "material_official_source_conflict",
    "schema_or_page_structure_change",
    "website_code_design_or_brand_change",
    "deployment_or_schedule_configuration_change"
  ]
}

