{
  "schemaVersion": "marketing-buddy-weekly-config-v1",
  "repository": "morningzy123-cloud/first-website",
  "baseBranch": "main",
  "publicUrl": "https://first-website-five-chi.vercel.app/",
  "timezone": "Asia/Shanghai",
  "dataFiles": ["data/public.json", "data/public.bundle.js", "data/release.json"],
  "workflowPath": ".github/workflows/validate.yml",
  "maxWaitSeconds": 600,
  "pollSeconds": 15,
  "maxChanges": 100,
  "lookbackDays": 7,
  "signalWindowDays": 30,
  "coverageCategories": ["offers", "selling_points", "specifications", "consumer_feedback", "sales", "policy", "shipping"],
  "vehicleFields": ["prices", "financeOffers", "aftersales", "salesRecords", "specifications", "marketingActivities", "recentEvents", "researchV2.priceNotes", "researchV2.dealerOffers", "researchV2.officialSellingPoints", "researchV2.officialSpecifications", "researchV2.consumerFeedback", "researchV2.audienceProfile"],
  "marketFields": ["basics.summary", "basics.taxImportAndPolicy", "researchV2.shippingRoutes"],
  "countryCardFields": ["entrySummary", "importantMarketNews", "importantCompetitorAction"],
  "overviewFields": ["highValueSignals"],
  "competitors": {
    "MX": ["kia-k3-mx", "mg5-mx"],
    "KZ": ["chevrolet-cobalt-kz", "chery-arrizo-6-kz"],
    "SA": ["mg5-sa", "toyota-yaris-sa"],
    "AE": ["mg5-ae", "nissan-sunny-ae", "toyota-yaris-ae", "changan-alsvin-ae"]
  }
}
